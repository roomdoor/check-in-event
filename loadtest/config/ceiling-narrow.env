# 이 설정이 찾던 무릎은 존재하지 않는다. 기록으로 남긴다.
#
#   ./loadtest/sweep.sh loadtest/config/ceiling-narrow.env
#
# 만들 때의 전제는 이랬다 — ceiling.env 가 "접수 한계 초당 약 3,300건",
# "p95 가 1600 에서 4.78ms, 3200 에서 990ms" 를 보였으니, 그 사이 어디서
# 지연이 무너지는지 400 간격으로 좁히자는 것이었다.
#
# 그 수치들이 워밍업 아티팩트였다. 스윕이 회차마다 앱을 재기동해서 매 회차가
# 갓 뜬 JVM 을 재고 있었다. 데워진 앱은 6,400 RPS 를 p95 2.15ms 에 받고
# 요청을 하나도 안 흘린다 — 1600~3200 사이에 무릎이 없다(README 5 장).
#
# 그래서 이 설정을 지금 돌리면 **콜드 구간의 모양**을 재게 된다. 그게 필요하면
# WARMUP_DURATION=0 과 함께 돌릴 것. 배포나 스케일아웃 도중 피크가 오는
# 상황이 그쪽이고, 그건 실제로 재볼 가치가 있다.
#
# 데워진 상태의 천장을 찾으려면 rate 를 6400 위로 올려야 하고, 그러려면
# 부하 호스트를 늘려야 한다. 이 설정으로는 안 된다.
MODES="redis"

# ceiling.env 와 같은 값. 드레이너는 이 구간에서 병목이 아님이 확인됐다.
WRITER_BATCH_SIZES="1600"
WRITER_DELAYS="100"

# 1600 과 3200 사이를 400 간격으로 훑는다. 두 배씩 벌리는 건 천장의 자리를
# 모를 때 쓰는 방법이고, 여기는 구간이 이미 좁아서 등간격이 맞다 — 라는 게
# 당시 판단이었다. 좁힌 구간 자체가 워밍업이 만든 것이라 헛짚었다.
RATES="2000 2400 2800"

CAPACITY=1000000
DURATION=1m
DUP_RATIO=0.1
REPEATS=1

# 이 구간은 지연이 낮으면 VU 가 얼마 안 든다(2800/s x 5ms = 14개). 무너지고
# 나서야 필요해진다. 2800/s 에서 평균 714ms 까지 미리 만들어 둔 것으로 덮는다.
PRE_VUS=2000
MAX_VUS=8000

DRAIN_CAP_SECONDS=1800

# 3회차. 회차마다 부하 1분 + 워밍업 기본값 30초 + 각각의 드레인 + 앱 재기동.
# 15~25분 본다.
