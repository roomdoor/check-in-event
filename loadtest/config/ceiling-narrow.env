# 승인 경로의 지연이 어디서 무너지는지 좁힌다.
#
#   ./loadtest/sweep.sh loadtest/config/ceiling-narrow.env
#
# ceiling.env 가 두 가지를 밝혔다. 접수 한계는 초당 약 3,300건이고(6400 을
# 줬는데 60초에 200,151건만 받았다), 드레이너는 범인이 아니다 — 초당 3,016건을
# 저장하면서도 드레인이 0초였다.
#
# 다만 쓸 수 있는 구간은 그보다 아래다. p95 가 1600 에서 4.78ms, 3200 에서
# 990ms 다. 200배가 그 사이에서 벌어지는데 두 점뿐이라 어디인지 모른다.
# db 쪽도 같은 모양이었다 — 천장은 205/s 인데 쓸 수 있는 건 100 언저리였다.
MODES="redis"

# ceiling.env 와 같은 값. 드레이너는 이 구간에서 병목이 아님이 확인됐다.
WRITER_BATCH_SIZES="1600"
WRITER_DELAYS="100"

# 1600 과 3200 사이를 400 간격으로 훑는다. 두 배씩 벌리는 건 천장의 자리를
# 모를 때 쓰는 방법이고, 여기는 구간이 이미 좁아서 등간격이 맞다.
RATES="2000 2400 2800"

CAPACITY=1000000
DURATION=1m
DUP_RATIO=0.1
REPEATS=1

# 이 구간은 지연이 낮으면 VU 가 얼마 안 든다(2800/s x 5ms = 14개). 무너지고
# 나서야 필요해진다. 2800/s 에서 평균 714ms 까지 미리 만들어 둔 것으로 덮는다.
PRE_VUS=2000
MAX_VUS=8000

DRAIN_CAP_SECONDS=1800

# 3회차. 부하 3분에 드레인과 앱 재기동이 붙어 6분쯤.
