# Redis 방식이 어디서 꺾이는지 찾는다.
#
#   ./loadtest/sweep.sh loadtest/config/ceiling.env
#
# 앞선 두 스윕이 답하지 못한 것: redis 는 800 RPS(초당 721건 저장)에서도
# 드레인 0초로 따라갔다. 한계가 그 위 어딘가라는 것만 안다.
#
# 꺾일 수 있는 자리가 둘이고, 한 스윕으로 둘 다 구분된다.
#
#   저장량이 도착률을 못 따라가면  -> 승인 경로(Lua/앱/Redis)가 한계
#   따라가는데 드레인이 길어지면    -> 드레이너(MySQL 저장)가 한계
#
# 둘 다 멀쩡하면 부하 생성기가 한계다. 그 경우 k6 가 요청 수를 못 채우고
# dropped_iterations 가 오른다 — 결과를 그렇게 읽을 것.
MODES="redis"

# 비교 스윕과 같은 값으로 고정한다. 이 스윕의 변수는 rate 하나다.
# 1600/100 은 1회차에서 초당 721건을 밀림 없이 받아낸 조합이다.
WRITER_BATCH_SIZES="1600"
WRITER_DELAYS="100"

# 800 은 이미 아는 지점이고 기준선이다. 거기서 두 배씩 올린다. 배수로
# 벌리는 이유는 어디쯤인지 모르기 때문이다 — 좁게 훑으면 천장이 구간 밖에
# 있을 때 아무것도 못 찾는다. 걸리는 구간을 찾고 나서 좁히면 된다.
RATES="800 1600 3200 6400"

# 정원은 가장 센 회차의 총 도착량보다 커야 한다. 6400 x 60초 = 384,000 이고,
# 중복 10%를 빼도 약 345,600 이 승인된다. 정원이 그보다 작으면 중간부터
# 전부 거절이 되는데, 거절은 저장하지 않으므로 재려던 저장 부하가 사라진다.
CAPACITY=1000000

DURATION=1m
DUP_RATIO=0.1
REPEATS=1

# VU 풀. 정상 구간에서는 거의 안 쓴다 — 6400/s 에 응답이 5ms 면 32개면 된다.
# 풀이 필요해지는 건 꺾이고 나서다.
#
# PRE_VUS 2000 은 6400/s 에서 평균 312ms 까지 미리 만들어 둔 것으로 덮는다.
# 그 위는 MAX_VUS 로 늘리되, 8000개를 전부 미리 만들면 부하 호스트
# 메모리(16GB)가 빠듯하다. 'Insufficient VUs' 가 뜨면 그 회차는 부하가 다
# 안 간 것이므로 p95 를 측정값으로 읽지 말 것.
PRE_VUS=2000
MAX_VUS=8000

# 드레인 대기 상한. 6400/s 로 384,000건을 넣고 드레이너가 초당 1,000건이라면
# 빼는 데만 300초가 넘는다. 기본값 600 으로는 '드레인미완' 으로 끝나
# Redis-DB 대조를 건너뛴다 — 그 회차가 천장을 말해주는 회차일 수 있어서
# 넉넉히 준다.
DRAIN_CAP_SECONDS=1800

# 4회차. 회차마다 부하 1분 + 워밍업 기본값 30초 + 각각의 드레인 + 앱 재기동이다.
# 워밍업이 붙기 전 이 설정이 5분에 끝난 적이 있으나, 그 회차들은 콜드 JVM 이라
# 수치를 쓸 수 없었다(README 5 장). 20~35분 본다.
#
# rate 800 회차는 30초 워밍업이 약 2만 4천 요청이라 기준을 겨우 넘는다.
# 결과 표의 워밍업 열(예: 30s/24k)로 회차마다 확인할 것.
