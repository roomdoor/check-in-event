# 드레이너 처리량 천장을 찾는다.
#
#   ./loadtest/sweep.sh loadtest/config/drainer.env
#
# 재려는 것: Redis 비동기 방식이 초당 몇 건까지 실제로 저장하는가.
#
# 저장 처리량은 batch_size / (저장시간 + delay) 다. fixedDelay 는 작업이 끝난
# 뒤부터 세므로, 저장이 느려지면 주기도 같이 길어져 밀릴수록 더 느려진다.
# 기본값(200/500ms)의 이론 상한이 초당 400건이고, 그게 실제로 얼마인지와
# 어디서 batch 를 키워도 안 늘어나는지를 본다.
MODES="redis"

# 200 은 현재 기본값이고 기준선이다. 8배 구간을 훑는다.
WRITER_BATCH_SIZES="200 800 1600"

# 주기를 줄이면 같은 batch 로도 처리량이 오른다. 다만 저장시간이 주기를
# 넘어서면 더 줄여도 의미가 없어진다 — 그 지점이 이 축의 답이다.
WRITER_DELAYS="500 100"

# 드레이너 상한(초당 400건) 위아래로 둔다. 아래에서는 실시간으로 따라잡고
# 위에서는 밀리므로, 드레인 시간이 그 차이를 드러낸다.
RATES="200 800"

# 정원을 부하보다 크게 둔다. 정원이 작으면 대부분이 거절인데 거절은 저장하지
# 않으므로, 정작 재려는 저장 부하가 안 걸린다.
CAPACITY=200000

DURATION=1m
DUP_RATIO=0.1
REPEATS=1

# 12회차 x (1분 부하 + 워밍업 30초 + 각각의 드레인 + 앱 재기동). 워밍업이
# 붙기 전 1020초였으므로 40~55분 본다.
