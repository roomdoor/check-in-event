# db 와 redis 를 같은 부하에 놓고 비교한다.
#
#   ./loadtest/sweep.sh loadtest/config/compare.env
#
# 재려는 것: 같은 초당 요청에서 두 방식이 각각 어디서 무너지는가.
#
# db 는 요청 안에서 INSERT 와 events 행 갱신을 끝내고 응답한다. 같은 이벤트
# 행을 모두가 잠그므로 직렬화되고, 응답 시간이 곧 저장 시간이다.
# redis 는 Lua 로 승인만 하고 persisted:false 로 답한 뒤 스케줄러가 옮긴다.
# 응답 시간은 저장과 무관해지고, 대신 드레인이라는 지연이 생긴다.
#
# 그래서 이 스윕에서 봐야 할 값이 모드마다 다르다.
#   db    : p95 와 dropped_iterations — 부하를 받아내지 못하면 여기 나타난다.
#   redis : 드레인 시간 — 응답은 계속 빠르고 밀린 양만 늘어난다.
MODES="db redis"

# 드레이너는 이 비교의 변수가 아니다. 1회차 스윕에서 1600/100 은 초당 720건을
# 밀림 없이 받아냈으므로(드레인 0s), 여기서는 병목이 아닌 자리에 고정해 둔다.
# 200/500 을 쓰면 redis 쪽 드레인 시간이 엔드포인트가 아니라 라이터 설정을
# 재는 값이 되어 비교가 흐려진다.
#
# db 모드는 이 값을 안 쓴다. sweep.sh 가 db 는 목록의 첫 조합으로만 한 번 돈다.
WRITER_BATCH_SIZES="1600"
WRITER_DELAYS="100"

# db 의 천장을 사이에 두도록 배수로 벌린다. 아래쪽은 두 방식이 똑같이
# 여유로운 구간이고, 위쪽은 redis 만 버티는 구간이다. 그 사이 어디서
# 갈라지는지가 이 스윕의 답이다.
RATES="100 200 400 800"

# 1회차와 같은 값. 정원이 부하보다 커야 거절이 저장 부하를 밀어내지 않는다.
CAPACITY=200000

# 1회차와 같은 값으로 둔다. 드레이너 수치와 나란히 놓고 읽으려면
# 부하 모양이 같아야 한다.
DURATION=1m
DUP_RATIO=0.1
REPEATS=1

# db 4회차 + redis 4회차 = 8회차. 앱 재기동까지 포함해 25~30분쯤 걸린다.
#
# db 가 초당 800건에서 크게 밀리면 드레인이 아니라 k6 쪽에서 이터레이션이
# 버려진다. 그건 불변식 위반이 아니라 결과로 기록된다 — 그게 재려던 값이다.
